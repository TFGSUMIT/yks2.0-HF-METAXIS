# METAXIS local environment template.
# Copy to .env only when a local tool explicitly loads it. Never commit .env.

# Secret credential. The authorized CI path injects the L2-mesh-backed
# YKS_OPS_SYNC_TOKEN as GH_TOKEN. Set one of these locally only for an
# authorized live GitHub issue mirror run. Prefer GH_TOKEN; GITHUB_TOKEN is the
# supported fallback.
GH_TOKEN=
# GITHUB_TOKEN=

# One-way root-issue mirror coordinates.
METAXIS_SOURCE_REPO=LittleYeti-Dev/yks2.0-ops-hub
METAXIS_SOURCE_ISSUE=422
METAXIS_TARGET_REPO=LittleYeti-Dev/yks2.0-HF-METAXIS
METAXIS_TARGET_ISSUE=1

# GitHub Actions supplies this automatically. Locally it is only a fallback for
# METAXIS_TARGET_REPO and normally does not need to be set.
# GITHUB_REPOSITORY=LittleYeti-Dev/yks2.0-HF-METAXIS

# Useful when running directly from the checkout without an editable install.
PYTHONPATH=src:.

# NemaShells/METAXIS local service. OrbStack managed Docker publishes only to
# the Mac loopback; PROTOS-3 reaches it through the private host.internal
# bridge. Do not change the host to 0.0.0.0 for the laptop profile.
METAXIS_HOST=127.0.0.1
METAXIS_PORT=4310
METAXIS_PROFILE=orbstack-development
METAXIS_DATA_CLASSIFICATION=DEVELOPMENT
METAXIS_HIGH_NOFORN_AUTHORITY_RECORD=
METAXIS_EXTERNAL_MODEL_CALLS=0
METAXIS_EXTERNAL_TELEMETRY=0
METAXIS_OPERATOR_CADENCE="5.6 sol"

# API-first brain route for resource-constrained local operation. The safe
# default is the deterministic mock. Enabling requires all three: explicit
# mode, external-call flag, and a custody-injected key. Never commit the key.
METAXIS_BRAIN_MODE=mock
METAXIS_BRAIN_URL=
METAXIS_BRAIN_API_KEY=
METAXIS_BRAIN_PROVIDER=
METAXIS_BRAIN_ROUTE_ID=
METAXIS_BRAIN_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-BF16
METAXIS_BRAIN_REVISION=cbd3fa9f933d55ef16a84236559f4ee2a0526848
METAXIS_BRAIN_DEVELOPER_COUNTRY=US
METAXIS_BRAIN_PLACEMENT=
METAXIS_BRAIN_MAX_OUTPUT_TOKENS=4096
METAXIS_BRAIN_TIMEOUT_SECONDS=60
METAXIS_BRAIN_US_PERSON_ADMIN_ONLY=0
METAXIS_BRAIN_US_PERSON_USER_ONLY=0
METAXIS_BRAIN_US_LOCATION_ONLY=0
METAXIS_BRAIN_EGRESS_DEFAULT_DENY=0
METAXIS_BRAIN_EXTERNAL_TELEMETRY_DISABLED=0
METAXIS_BRAIN_CUSTODY_APPROVED=0

# Hugging Face Phase 0. HF_TOKEN is released from the L2 credential mesh only
# for an authorized operation; do not persist it in this file.
HF_TOKEN=
HF_HUB_DISABLE_IMPLICIT_TOKEN=1
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_DISABLE_UPDATE_CHECK=1
HF_HUB_OFFLINE=0

# Keep HF caches and stored-token paths outside the repository. Defaults are
# under ~/.cache/huggingface and normally do not need to be overridden.
# HF_HOME=/absolute/external/cache/path
# HF_HUB_CACHE=/absolute/external/cache/path/hub
# HF_TOKEN_PATH=/absolute/external/credential/path
