#!/bin/sh
set -eu

command_name=$(basename "$0")

case "$command_name:${1:-}" in
  yetis:live|yeti:live|yetis-live:|yeti-live:)
    exec /usr/local/bin/nemashells-tauri
    ;;
  *)
    printf '%s\n' 'usage: yetis live' >&2
    printf '%s\n' 'boots the PROTOS-4 NemaShells Tauri lane after its METAXIS health gate' >&2
    exit 64
    ;;
esac
