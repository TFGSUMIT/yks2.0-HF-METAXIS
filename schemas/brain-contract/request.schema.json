{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/LittleYeti-Dev/yks2.0-HF-METAXIS/schemas/brain-contract/request.schema.json",
  "title": "METAXIS Brain Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "messages", "max_output_tokens", "temperature"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "string"}
        }
      }
    },
    "tools": {"type": "array", "items": {"type": "object"}},
    "max_output_tokens": {"type": "integer", "minimum": 1},
    "temperature": {"type": "number", "minimum": 0, "maximum": 2},
    "authority_context": {"type": "object"}
  }
}

